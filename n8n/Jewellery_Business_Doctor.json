    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into sales (sale_date, store, category, item, units, revenue)\nselect nullif($1::text,'')::date, $2::text, $3::text, $4::text, nullif($5::text,'')::int, nullif($6::text,'')::numeric\nwhere nullif($1::text,'') is not null\non conflict (sale_date, store, item) do update\nset category = excluded.category, units = excluded.units, revenue = excluded.revenue",
        "options": {
          "queryReplacement": "={{ [$json.sale_date ?? \"\", $json.store ?? \"\", $json.category ?? \"\", $json.item ?? \"\", String($json.units ?? \"\"), String($json.revenue ?? \"\")] }}"
        }
      },
