    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with upd as (update stock_by_store set item=$3, category=$4, units_in_stock=coalesce(nullif($5,'')::int, units_in_stock), reorder_level=coalesce(nullif($6,'')::int, reorder_level), stock_date=(case when $7::text ~ '^[0-9]+$' then date '1899-12-30' + $7::text::int else nullif($7::text,'')::date end) where item_code=$1 and store=$2 returning 1) insert into stock_by_store (item_code, item, category, store, units_in_stock, reorder_level, stock_date) select $1, $3, $4, $2, nullif($5,'')::int, nullif($6,'')::int, (case when $7::text ~ '^[0-9]+$' then date '1899-12-30' + $7::text::int else nullif($7::text,'')::date end) where not exists (select 1 from upd)",
        "options": {
          "queryReplacement": "={{ [$json.item_code ?? \"\", $json.store ?? \"\", $json.item ?? \"\", $json.category ?? \"\", String($json.units_in_stock ?? \"\"), String($json.reorder_level ?? \"\"), String($json.stock_date ?? \"\")] }}"
        }
      },
